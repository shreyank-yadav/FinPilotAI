# Copy to backend/.env. Set a strong, unique JWT_SECRET before enabling accounts.
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/finpilot
JWT_SECRET=

# Internal analytics service. Set the same optional key in the backend process
# and analytics process if analytics API-key protection is desired.
ANALYTICS_URL=http://127.0.0.1:8000
ANALYTICS_API_KEY=

# Optional AI Advisor provider configuration. Keep this file backend-only.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Used only with LLM_PROVIDER=openai; defaults to https://api.openai.com/v1.
LLM_BASE_URL=
